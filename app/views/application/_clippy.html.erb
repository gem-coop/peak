<script nonce="<%= request.content_security_policy_nonce %>">
  class Clippy {
    static addGem(name) {
      const text = `bundle add ${name} --source "<%= source_url.to_json %>"`
      navigator.clipboard.writeText(text)
    }

    static copyNextElementSiblingText(element) {
      navigator.clipboard.writeText(element.nextElementSibling.textContent.trim())
    }
  }
</script>
