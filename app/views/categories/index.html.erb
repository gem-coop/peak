<%= flash[:alert]&.then { tag.p tag.i _1 } %>

<header>
  <% namespace = Namespace.named(:@rubygems) %>
  <h1><%= link_to namespace.name, namespace_path(namespace) %> categories</h1>
  <p>Ack, there's so many gems! These categories help you identify which gems to look into grouped by the problem they solve.</p>

  <%= render "categories/acknowledgement" %>
</header>

<section style="display: flex; flex-wrap: wrap; column-gap: 1em; margin-block: 2em 1em;">
  <span><%= link_to "ALL", nil, aria: { current: ("page" unless @letters.include?(params[:l])) } %></span>
  <span>|</span>

  <% @letters.each do |l| %>
    <span><%= link_to l, url_for(l:), aria: { current: ("page" if params[:l] == l) } %></span>
  <% end %>
</section>

<article style="display: grid; display: grid-lanes; grid-template-columns: repeat(auto-fill, minmax(35ch, 1fr)); gap: 10px;">
  <%= render partial: "categories/group", collection: @groups %>
</article>
