<span><%= link_to "← categories", categories_path %> / category</span>

<header style="display: flex; flex-wrap: wrap; column-gap: 1em; align-items: baseline;">
  <h2><%= @category.name %></h2>
  <span><%= link_to "See on ruby-toolbox ↗", toolbox_category_url(@category) %></span>
  <span><%= @category.description %></span>
</header>

<h3>available from <%= link_to @namespace.name, @namespace %></h3>

<section style="display: flex; flex-direction: column; row-gap: 10px;">
  <% @versions.each do |version| %>
    <article>
      <h3 style="margin-block-end: 0; display: inline-block;">
        <%= link_to version.gem.name, namespace_gem_path(@namespace, version.gem, index: nil) %>
      </h3>

      <p style="margin-block-end: 0;"><i><%= version.summary %></i></p>

      <%= render "gem/versions/list", versions: [version] %>
    </article>
  <% end %>
</section>

<footer style="margin-block-start: 5em;">
  <%= render "categories/acknowledgement" %>
</footer>
