<span><%= link_to "← categories", categories_path %> / category</span>

<header style="display: flex; flex-wrap: wrap; column-gap: 1em; align-items: baseline;">
  <h2><%= @category.name %></h2>
  <span><%= link_to "See on ruby-toolbox ↗", toolbox_category_url(@category) %></span>
  <span><%= @category.description %></span>
</header>

<% recent, older = 5.years.ago.then { |t| @versions.partition { _1.published_at.after? t } } %>

<h3>recent from <%= link_to @namespace.name, @namespace %></h3>

<section style="display: flex; flex-direction: column; row-gap: 10px;">
  <%= render(partial: "gem/versions/version", collection: recent, locals: { namespace: @namespace }) || tag.span("None.") %>
</section>

<hr>

<h3>older from <%= link_to @namespace.name, @namespace %></h3>

<section style="display: flex; flex-direction: column; row-gap: 10px;">
  <%= render(partial: "gem/versions/version", collection: older, locals: { namespace: @namespace }) || tag.span("None.") %>
</section>

<footer style="margin-block-start: 5em;">
  <%= render "categories/acknowledgement" %>
</footer>
