<%= tag.h1 page.title = "Dashboard" %>

<p>Hi, <%= Current.user.name %>!</p>

<%= tag.i render "peak/terms/acceptances/new/banner" %>

<h2>Your namespaces</h2>

<% if Current.user.namespaces.load.any? %>
  <p>
    Looking to push releases?

    <i><%= link_to "Create a new push key", new_user_push_key_path(Current.user.slice(:email_address)) %></i>
  </p>

  <ul>
    <% Current.user.namespaces.each do |namespace| %>
      <li><%= link_to namespace.name, namespace %></li>
    <% end %>
  </ul>
<% else %>
  <p>You're not part of any namespaces yet.</p>
<% end %>

<p><%= button_to "Sign out", sign_out_path, method: :delete %></p>
