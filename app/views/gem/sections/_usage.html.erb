<% button = tag.button onclick: "Clippy.copyNextElementSiblingText(this.parentElement)", data: { gem_name: name }, style: "padding: 4px;" do %>
  <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" height="16" width="16" viewBox="0 0 256 256" fill="currentColor">
    <path d="M172,164a12,12,0,0,1-12,12H96a12,12,0,0,1,0-24h64A12,12,0,0,1,172,164Zm-12-52H96a12,12,0,0,0,0,24h64a12,12,0,0,0,0-24Zm60-64V216a20,20,0,0,1-20,20H56a20,20,0,0,1-20-20V48A20,20,0,0,1,56,28H90.53a51.88,51.88,0,0,1,74.94,0H200A20,20,0,0,1,220,48ZM100.29,60h55.42a28,28,0,0,0-55.42,0ZM196,52H178.59A52.13,52.13,0,0,1,180,64v8a12,12,0,0,1-12,12H88A12,12,0,0,1,76,72V64a52.13,52.13,0,0,1,1.41-12H60V212H196Z"></path>
  </svg>
<% end %>

<h3>usage</h3>
<dl style="display: flex; flex-direction: column; gap: .2em;">
  <dt>run on your commandline <%= button %></dt>
  <dd>
    <pre style="margin-block-end: 0;"><code>bundle add <%= name %> --source "<%= source_url %>"</code></pre>
  </dd>

  <dt>or, put in your Gemfile <%= button %></dt>
  <dd>
    <pre><code>gem "<%= name %>", source: "<%= source_url %>"</code></pre>
  </dd>
</dl>
