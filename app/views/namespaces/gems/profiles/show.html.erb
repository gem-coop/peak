<section>
  <%= render "breadcrumbs/trail", trail: @breadcrumb_trail %>

  <%= tag.h1 page.title = @gem.namespaced_name %>

  <% latest = @gem.versions.pure.latest %>
  <p style="margin-block-end: 2em;"><i><%= latest.summary %></i></p>

  <section style="display: grid; grid-template-columns: 50% 50%; margin-block-end: 1em;">
    <section>
      <h3 style="display: inline;">details</h3>

      <dl data-condensed style="margin-block: 0;">
        <div>
          <dt>latest</dt>
          <dd><%= latest.ref %></dd>
        </div>

        <div>
          <dt>licenses</dt>
          <dd><%= latest.licenses.join(" ").presence || "none" %></dd>
        </div>

        <div>
          <dt>ruby</dt>
          <dd><%= latest.ruby %></dd>
        </div>

        <div>
          <dt>rubygems</dt>
          <dd><%= latest.rubygems %></dd>
        </div>

        <div>
          <dt>executables</dt>
          <dd><%= latest.executables.join(" ").presence || "none" %></dd>
        </div>

        <div>
          <dt>native extensions</dt>
          <dd><%= latest.has_extensions? ? "yes" : "none" %></dd>
        </div>

        <div>
          <dt data-expanded>platforms</dt>
          <% @gem.platforms.pluck(:key).sort.each do |key| %>
            <dd style="margin-block-end: 0;"><%= key %></dd>
          <% end %>
        </div>
      </dl>
    </section>

    <% if links = latest.links.group_by(&:value).presence %>
      <details open style="overflow-wrap: break-word;">
        <summary style="cursor: pointer;"><h3 style="display: inline;">links</h3></summary>

        <dl style="margin-block: 0;">
          <% links.each do |value, links| %>
            <%= safe_join links.map { tag.dt _1.key } %>
            <%= tag.dd link_to(value, value, target: "_blank"), style: "font-size: var(--font-sm);" %>
          <% end %>
        </dl>
      </details>
    <% end %>
  </section>

  <section>
    <h3 style="margin-block: 0;">versions</h3>

    <%= render "gem/versions/list", versions: @gem.versions.latest_first.pure.as_byline.first(20) %>

    <div>
      <%= link_to tag.i("See raw versions list →"), namespace_info_path(@index.namespace) %>
    </div>
  </section>

  <%= render "clippy", source_url: polymorphic_url(@index.namespace) %>
  <%= render "gem/sections/usage", name: @gem.name, source_url: polymorphic_url(@index.namespace) %>
</section>
