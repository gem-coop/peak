<% page.title = [@gem.namespace.name, @gem.name].join("/") %>

<% source_url = polymorphic_url @index.namespace %>
<%= render "clippy", source_url: %>

<section>
  <h1 style="font-size: 1.17em; font-weight: normal;">
    <%= link_to @gem.namespace.name, @gem.namespace %>/<%= tag.span @gem.name, style: "padding-inline-start: .5em;" %>
  </h1>

  <% latest = @gem.versions.latest_first.pure.first %>
  <p style="margin-block-start: 0;"><i><%= latest.summary %></i></p>

  <section style="display: grid; grid-template-columns: 50% 50%; margin-block-end: 1em;">
    <section>
      <h3 style="display: inline;">details</h3>

      <dl data-condensed style="margin-block: 0;">
        <div>
          <dt>latest</dt>
          <dd><%= latest.ref %><%= tag.button :🔗, onclick: "Clippy.addGem('#{@gem.name}')", style: "height: 2em;" %></dd>
        </div>

        <div>
          <dt>licenses</dt>
          <dd><%= latest.licenses.join(" ").presence || "none" %></dd>
        </div>

        <div>
          <dt>ruby</dt>
          <dd><%= latest.ruby %></dd>
        </div>

        <div>
          <dt>rubygems</dt>
          <dd><%= latest.rubygems %></dd>
        </div>

        <div>
          <dt>executables</dt>
          <dd><%= latest.executables.join(" ").presence || "none" %></dd>
        </div>

        <div>
          <dt>native extensions</dt>
          <dd><%= latest.has_extensions? ? "yes" : "none" %></dd>
        </div>

        <div>
          <dt data-expanded>platforms</dt>
          <% @gem.platforms.pluck(:key).sort.each do |key| %>
            <dd style="margin-block-end: 0;"><%= key %></dd>
          <% end %>
        </div>
      </dl>
    </section>

    <% if links = latest.links.group_by(&:value).presence %>
      <details open style="overflow-wrap: break-word;">
        <summary style="cursor: pointer;"><h3 style="display: inline;">links</h3></summary>

        <dl style="margin-block: 0;">
          <% links.each do |value, links| %>
            <%= safe_join links.map { tag.dt _1.key } %>
            <%= tag.dd link_out_to(value, value), style: "font-size: var(--font-sm);" %>
          <% end %>
        </dl>
      </details>
    <% end %>
  </section>

  <section>
    <h3 style="margin-block: 0;">versions</h3>

    <%= render "gem/versions/list", versions: @gem.versions.latest_first.pure.as_byline.first(20) %>

    <div>
      <%= link_to tag.i("See raw versions list →"), namespace_info_path(@index.namespace, @gem) %>
    </div>
  </section>

  <%= render "gem/sections/usage", name: @gem.name, source_url: %>
</section>
