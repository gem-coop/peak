<% page.title = @index.namespace.name %>

<% source_url = polymorphic_url @index.namespace %>
<%= render "clippy", source_url: %>

<section>
  <div>
    <h1><%= @index.namespace.name %></h1>

    <small><i>Owned by</i></small>
    <ul class="list-none" style="margin-block-start: 0;">
      <% @index.namespace.accesses.owner.extract_associated(:user).each do |user| %>
        <%= tag.li user.name %>
      <% end %>
    </ul>
    <% if owner_of?(@index.namespace) %>
      <p><%= link_to "Pending Trusted Publishers", namespace_trusted_publishers_path(namespace: @index.namespace.name) %></p>
    <% end %>
  </div>

  <% if @gems.empty? %>
    <h3>gems</h3>
    <p>No gems yet.</p>
    <p>Generate <%= link_to "a new push key", new_user_push_key_url %> to get started.</p>
  <% else %>
    <div>
      <h3 style="display: inline;">gems</h3>
    </div>

    <section style="min-height: 300px;">
      <% @versions.each do |gem, version| %>
        <article>
          <h3 style="margin-block-end: 0; display: inline-block;">
            <%= link_to gem.name, namespace_gem_path(gem.namespace, gem, index: nil) %>
          </h3>
          <%= tag.button :🔗, onclick: "Clippy.addGem('#{gem.name}')", style: "height: 2em;" %>

          <p><i><%= version.summary %></i></p>

          <%= render "gem/versions/list", versions: [version] %>
        </article>
      <% end %>
    </section>
  <% end %>

  <%= render "gem/sections/usage", name: @gems.first&.name || "<name>", source_url: %>
</section>
