<% -> { highlight _1, @query } => highlighter %>

<div>
  <% page.title = "search namespaces & gems" %>

  <%= form_with url: search_path, method: :get, html: { style: "margin-block: 0;" } do |form| %>
    <%= form.label(:q, class: "font-sm") { tag.span page.title } %>

    <div style="display: flex; gap: 1em;">
      <%= form.text_field :q, value: @query, placeholder: "gem names, summaries", style: "flex: 3; margin-block-end: .5em;" %>
      <%= form.button "Search", name: nil, style: "flex: 1;" %>
    </div>

    <%= link_to "reset →" if @query %>
  <% end %>

  <h2 style="font-size: 1.117em;">results</h2>
</div>

<section id="search-listings" style="display: flex; flex-direction: column; gap: 1em;">
  <% if @namespaces.empty? && @search_indexes.empty? %>
    <span>None.</span>

    <p>You can search for namespace names & gem names. You can also find gems by the summary in their latest version.</p>
  <% else %>
    <% @namespaces.each do |namespace| %>
      <article>
        <span><i>namespace</i></span>

        <h3 style="margin-block: 0;">
          <%= link_to highlighter[namespace.name], namespace %>
        </h3>
      </article>
    <% end %>

    <% @search_indexes.each do |search_index| %>
      <article>
        <span><i>gem</i></span>

        <h3 style="margin-block: 0;">
          <%= link_to highlighter[search_index.gem.namespaced_name], search_index.gem %>
        </h3>

        <p style="margin-block: 0;"><%= highlighter[search_index.stripped] %></p>
      </article>
    <% end %>
  <% end %>
</section>
