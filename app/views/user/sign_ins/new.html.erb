<% if error = flash[:alert] %>
  <%= tag.h4 tag.i(error), style: "margin-block-end: 5em;" %>
<% end %>

<%= tag.h1 page.title = "Sign In" %>

<p>Enter your email address and we'll send you a sign-in link.</p>

<%= form_with url: sign_in_index_path do |form| %>
  <%= form.label :email_address, "email address" %>
  <%= form.email_field :email_address, required: true, placeholder: "me@example.com" %>

  <%= form.button "Send sign-in link" %>
<% end %>
