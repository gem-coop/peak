#!/usr/bin/env ruby
# frozen_string_literal: true

# Contribute to the upstream repo rather than manually updating the generated categories.yml.
# The catalog repo has its own processing, but that has dependencies and it seemed simpler to write our own extruding.
`git clone --depth 1 https://github.com/rubytoolbox/catalog tmp/catalog` unless Dir.exist?("tmp/catalog")
Dir.chdir("tmp/catalog") { `git pull origin main` }

require "yaml"
require "pathname"

groups = Pathname.glob("tmp/catalog/catalog/**/_meta.yml").to_h do |file|
  name = YAML.safe_load(file.read)["name"]
  [file.dirname.basename.to_s, { "name" => name, "categories" => [] }]
end

Pathname.glob("tmp/catalog/catalog/**/*.yml").each do |file|
  key = file.dirname.basename.to_s
  permalink = file.basename.to_s.delete_suffix(".yml")
  next if permalink == "_meta"

  data = YAML.safe_load(file.read)
  data["permalink"] = permalink
  data["projects"].delete_if { _1.include? "/" }

  groups.fetch(key)["categories"] << data unless data["projects"].empty?
end

sorted = groups.values.sort_by { it["name"] }
sorted.each { it["categories"] = it["categories"].sort_by { it["name"] } }

Pathname("config/storage/categories.yml")
  .write "# Auto-generated by bin/categorize.\n" + YAML.dump(sorted)
