#!/usr/bin/env bin/rails runner

puts <<~HELP if ARGV.none?
  #{$0} GEM_NAME [OPTIONS]

  Downloads a gemspec then prints it.

  #{$0} railties 8.1.0 --full --console

  -c, --console  Start an IRB session with the loaded gemspec.
  -f, --full     Don't strip lengthy files array from gemspecs when printing.
HELP
exit 1 if ARGV.none?

name = ARGV.first
ref = ARGV.second
console = (ARGV & ["-c", "--console"]).any?
full = (ARGV & ["-f", "--full"]).any?

gem = Namespace.named(:@rubygems).gems.new(name:)
spec = Peak::Gem::Gemspec.new gem.server.gemspec(ref)

files = spec.spec.files
spec.spec.files = [] unless full # Extract files since they can take a lot of vertical space
pp spec

binding.irb if console
