#!/usr/bin/env bin/rails runner

# mirror gems in config/storage/categories.yml:
#   bin/mirror --categories (also implies -l 1)
#
# limit mirror to just the latest N versions:
#   bin/mirror -l 1
#
# exact name match:
#   bin/mirror -r rails
#
# regexp match:
#   bin/mirror -r /rails/
#
# pass a different namespace:
#   bin/mirror @kaspth -r oaken

limit = nil

if i = ARGV.index("-l")
  limit = ARGV.slice!(i, 2).last.to_i
end

if i = ARGV.index("-r")
  match = ARGV.slice!(i, 2).last
  match = Regexp.new $1 if match =~ /^\/(.*)\/$/
end

categories = ARGV.delete("--categories")
limit ||= 1 if categories
Namespace::Gem::Imports.limit = limit if limit

name = (ARGV.shift || "@rubygems").then.find { _1.start_with?("@") } or raise "pass a valid namespace name"
namespace = Namespace.named(name)

mirror = namespace.build_mirror(url: "https://rubygems.org/").tap(&:readonly!)
names = categories ? Peak::Category.projects : mirror.names.grep(match)

if names.empty?
  puts "found 0 gems matching #{match}"
  exit 1
end

message = "found #{names.size} gems… import them? [y/N] (p for print)"
puts message

until (res = gets.chomp) == "y"
  if res == "p"
    puts names
    puts
    puts message
  else
    exit 1
  end
end

puts "importing #{names.size} gems…"
ApplicationJob.with logger: Logger.new(STDOUT) do
  queues = mirror.queue_cycle
  names.each_slice(500) { mirror.enqueue_batch _1, queue: queues.next }
end

ApplicationJob.queue_adapter.shutdown(wait: true)
