#!/usr/bin/env bin/rails runner

def relay(gem, download, upload)
  refs = CooldownVersion::Server.info(gem.name).split("\n").map { _1.split(" ", 2).first }.reject { _1 == "---" }
  refs.map do |ref|
    package = download.get("/gems/#{gem.name}-#{ref}.gem").body.to_s
    upload.post("/api/v1/gems", body: StringIO.new(package))
  end
end

name, gem_name = ARGV.first, ARGV.second
gem = Namespace.named(name).external_index.gems.find_or_create_by(name: gem_name)

base = HTTPX.plugin(:brotli).with(resolver_class: :system) # Use system DNS resolver to work with puma-dev on peak.test
download = base.with(origin: "https://gem.coop")

origin = ARGV.include?("--remote") ? "https://beta.gem.coop" : "http://peak.test"
upload = base.plugin(:auth).bearer_auth(ENV.fetch("GEM_HOST_API_KEY")).with(origin:, base_path: "/#{name}")

relay gem, download, upload
gem.revisionist.backdate_published_at
