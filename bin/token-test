#!/bin/bash

function test_token() {
    echo "Testing token for $URL"
    TOKEN=$(curl "$URL/rails/echo" --cookie-jar /tmp/cookie.txt -s | jq .csrf.form_param -r)
    echo "CSRF token: $TOKEN"
    curl "$URL/rails/echo" -F "authenticity_token=$TOKEN" --cookie /tmp/cookie.txt -s | jq -r '. | "form token: \(.csrf.valid_token)"'
    curl "$URL/rails/echo" -H "x-csrf-token: $TOKEN" --cookie /tmp/cookie.txt -s | jq -r '. | "header GET token: \(.csrf.valid_token)"'
    curl "$URL/rails/echo" -X POST -H "x-csrf-token: $TOKEN" --cookie /tmp/cookie.txt -s | jq -r '. | "header POST token: \(.csrf.valid_token)"'
    curl "$URL/rails/echo?authenticity_token=$TOKEN" --cookie /tmp/cookie.txt -s | jq -r '. | "query token: \(.csrf.valid_token)"'
    echo
}

URL="http://localhost:7676"
test_token
URL="https://peak.test"
test_token
URL="https://gem-coop-staging.fly.dev"
test_token
URL="https://staging.gem.coop"
test_token
